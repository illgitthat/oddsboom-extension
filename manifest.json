{
  "manifest_version": 3,
  "name": "Oddsboom",
  "version": "2.0.0",
  "description": "See American or decimal odds (fees included) next to every price on Kalshi, Polymarket, ProphetX and Novig, plus max-stake limits on sportsbooks.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Oddsboom"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://kalshi.com/*",
        "https://*.kalshi.com/*",
        "https://polymarket.us/*",
        "https://*.polymarket.us/*",
        "https://polymarket.com/*",
        "https://*.polymarket.com/*",
        "https://prophetx.co/*",
        "https://*.prophetx.co/*",
        "https://novig.com/*",
        "https://*.novig.com/*"
      ],
      "js": ["odds/core.js", "odds/content.js"],
      "css": ["odds/odds.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.williamhill.com/*",
        "https://sportsbook.caesars.com/*",
        "https://sportsbook.draftkings.com/*"
      ],
      "js": ["limits/fetch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.betway.com/*"],
      "js": ["limits/xhr.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
